<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('./partials/navbar') %>
    <h1>Edit Food</h1>

     <form action="/food/<%= food._id %>?_method=PUT" method="post">
        <label for="name">Name</label>
        <input value="<%= food.name %>" name="name" id="name" type="text">

        <label for="ingredients">Is Ready To Eat?</label>
        <input value="<%= food.ingredients %>" name="ingredients" id="ingredients" type="text">
        <button>Update Food</button>
    </form>
</body>
</html>